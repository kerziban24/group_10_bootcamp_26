    {
      "parameters": {
        "jsCode": "const question = $('Chat Webhook').first().json.body.question;\nconst records = $input.first().json.records || [];\nconst latestSummary = records.length ? records[0].fields.Summary : 'Bugün için henüz brifing üretilmedi.';\nconst promptText = `Aşağıda bugünkü piyasa brifingi var:\\n\\n${latestSummary}\\n\\nKullanıcının sorusu: \"${question}\"\\n\\nBu brifinge dayanarak kısa, net ve Türkçe bir cevap ver. Eğer soru brifingde cevaplanamıyorsa bunu dürüstçe belirt.`;\nconst claudeBody = JSON.stringify({\n  model: 'claude-sonnet-5',\n  max_tokens: 400,\n  messages: [{ role: 'user', content: promptText }]\n});\nreturn [{ json: { claudeRequestBody: claudeBody } }];"
      },
      "name": "Build Chat Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "9aca30d1-68bd-4ec1-818a-29d22d288eb0",
