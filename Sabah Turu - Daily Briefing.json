    {
      "parameters": {
        "jsCode": "const news = $input.first().json;\nconst list = Array.isArray(news) ? news : [];\nconst top = list.slice(0, 6).map(n => `- ${n.headline} (${n.source})`).join('\\n');\nreturn [{ json: { headlinesBlock: top } }];"
      },
