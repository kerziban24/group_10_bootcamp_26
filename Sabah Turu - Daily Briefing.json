      "name": "Get Quote",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "id": "c3035275-6149-4c22-83e4-04b161e7440d",
      "position": [
        224,
        288
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst tickerItems = $('Ticker List').all();\nreturn items.map((item, i) => {\n  const ticker = tickerItems[i] ? tickerItems[i].json.ticker : 'UNKNOWN';\n  return { json: { ticker, ...item.json } };\n});"
      },
      "name": "Attach Ticker",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "64c690c6-6c42-42c0-b366-51c95348b82e",
      "position": [
        448,
        288
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst newsBlock = $('Format News').first().json.headlinesBlock;\nlet priceBlock = '';\nfor (const item of items) {\n  const d = item.json;\n  const changePct = d.pc ? (((d.c - d.pc) / d.pc) * 100).toFixed(2) : 'N/A';\n  priceBlock += `${d.ticker}: $${d.c} (${changePct}% change)\\n`;\n}\nconst today = new Date().toISOString().slice(0, 10);\nconst promptText = `You are writing a short daily market briefing in Turkish for a retail investor.\\n\\nToday's prices:\\n${priceBlock}\\nToday's top market headlines:\\n${newsBlock}\\n\\nWrite a 3-paragraph briefing: (1) overall market mood, (2) what happened with each ticker and why it matters, (3) one thing to watch tomorrow. Keep it under 200 words, friendly but precise tone, written in Turkish.`;\nconst claudeBody = JSON.stringify({\n  model: 'claude-sonnet-5',\n  max_tokens: 600,\n  messages: [{ role: 'user', content: promptText }]\n});\nreturn [{ json: { date: today, priceBlock, newsBlock, claudeRequestBody: claudeBody } }];"
      },
      "name": "Aggregate All Tickers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "cbdea375-9b5a-415a-b451-e25fe05d9579",
      "position": [
        672,
        144
      ]
    },
    {
      "parameters": {
        "jsCode": "const res = $input.first().json;\nconst textBlock = (res.content || []).map(c => c.text).join('\\n');\nconst date = $('Aggregate All Tickers').first().json.date;\nconst emailBody = JSON.stringify({\n  from: 'Sabah Turu <briefing@yourdomain.com>',\n  to: ['you@example.com'],\n  subject: `Sabah Turu - ${date}`,\n  html: `<p>${textBlock.replace(/\\n/g, '<br>')}</p>`\n});\nreturn [{ json: { date, summary: textBlock, emailRequestBody: emailBody } }];"
      },
